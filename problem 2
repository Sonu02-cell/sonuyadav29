#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<long long> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    long long k;
    cin >> k;

    for (int i = 1; i < n; i++) {
        if (abs(a[i] - a[0]) % k != 0) {
            cout << -1 << endl;
            return 0;
        }
    }

    sort(a.begin(), a.end());

    long long target = a[n / 2];

    long long operations = 0;
    for (int i = 0; i < n; i++) {
        operations += abs(a[i] - target) / k;
    }

    cout << operations << endl;

    return 0;
}
